# Copie para .env na raiz do projeto e ajuste. NÃO comitar o .env real.
# Porta local (nginx faz proxy para cá). 8000 está livre na VPS.
PORT=8000
# Diretório de dados persistentes (catálogo SQLite, cache, token.key).
COLLECTOR_DATA=/var/www/coletor/data
# Operação real: demo desligado, worker separado (rodamos worker.py no PM2).
COLLECTOR_DEMO_MODE=0
COLLECTOR_EMBEDDED_WORKER=0
# Hosts externos autorizados para coleta (fonte dos links do IPHAN/SEI).
COLLECTOR_ALLOWED_HOSTS=www.gov.br,portal.iphan.gov.br,sei.iphan.gov.br
SHAREPOINT_ALLOWED_HOSTS=arqueogis.sharepoint.com
# Integração Microsoft/SharePoint (preencher conforme docs/SHAREPOINT.md; pode ficar vazio no início).
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
# SHAREPOINT_FOLDER_URL=link_da_pasta
# Opcional: chave Fernet de cofre. Sem ela, token.key é criado no COLLECTOR_DATA.
# COLLECTOR_TOKEN_KEY=
# Nome do administrador (a senha é definida interativamente no bootstrap.py).
COLLECTOR_ADMIN_NAME=administrador
