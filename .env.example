# Carregue estas variáveis no shell, sem incluir credenciais no arquivo.
COLLECTOR_DATA=./data
# Allowlist exata, somente HTTPS/443. Não usar curingas.
COLLECTOR_ALLOWED_HOSTS=www.gov.br,portal.iphan.gov.br,sei.iphan.gov.br
# O cliente de referência lê COLLECTOR_TOKEN e COLLECTOR_DELEGATION_ID do ambiente.
# Defina tokens em cofre/secret binding, não neste arquivo.
